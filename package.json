{
  "name": "tiktok-streak-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "login": "bun src/cli/index.ts login",
    "chats": "bun src/cli/index.ts chats",
    "test:send": "bun src/cli/index.ts dry-run",
    "send": "bun src/cli/index.ts send",
    "start": "bun src/cli/index.ts start",
    "status": "bun src/cli/index.ts status",
    "build": "bun --bun tsc",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.test.json",
    "test": "bun --bun vitest run",
    "lint": "bun --bun eslint .",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run format:check",
    "browser:install": "bun --bun playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "playwright": "^1.64.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.2"
}
